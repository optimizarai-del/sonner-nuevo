# Copiar a backend/.env y completar. NUNCA commitear el .env real.
# Los valores de ejemplo vacíos son obligatorios salvo que diga lo contrario.

# ── Auth ──────────────────────────────────────────────────────────────────────
# OBLIGATORIO: sin esto el backend no arranca (a propósito).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Opcional: sin esto el debounce es en memoria y hay que correr con 1 worker.
REDIS_URL=

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Grafo ─────────────────────────────────────────────────────────────────────
SONNER_MAX_ITER=6
SONNER_MAX_TOOL_CALLS=8
SONNER_LLM_TIMEOUT=45
SONNER_LLM_MAX_RETRIES=2
WA_BUFFER_SECONDS=15

# ── WhatsApp (YCloud) ─────────────────────────────────────────────────────────
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_SEND_URL=https://api.ycloud.com/v2/whatsapp/messages/sendDirectly

# ── Telegram ──────────────────────────────────────────────────────────────────
# ROTAR: este token estuvo embebido en los exports de n8n.
TELEGRAM_BOT_TOKEN=
GABI_TELEGRAM_CHAT_ID=
# Chat técnico para alertas del sistema. Si queda vacío se usa el de Gabi.
ALERT_TELEGRAM_CHAT_ID=

# ── Observabilidad ────────────────────────────────────────────────────────────
SONNER_ALERT_ENABLED=true
SONNER_ALERT_WINDOW_SECONDS=600
SONNER_METRICS_ENABLED=true

# ── Google: contratos (Drive/Docs) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_TEMPLATE_DOC_ID=
GOOGLE_DRIVE_CONTRATOS_FOLDER_ID=

# ── Google: agente (Calendar + Sheets) ────────────────────────────────────────
# ROTAR: el client secret estuvo hardcodeado en app/config.py.
# Proyecto OAuth distinto al de contratos (necesita scopes calendar + sheets).
GOOGLE_AGENT_CLIENT_ID=
GOOGLE_AGENT_CLIENT_SECRET=
GOOGLE_AGENT_REFRESH_TOKEN=
GCAL_EVENTOS_ID=
GCAL_REUNIONES_ID=
GSHEET_SALONES_ID=
# Calendarios de terceros que el agente interno SOLO lee.
GCAL_TIJERETA_ID=
GCAL_CROMO_ID=
# Planilla de DJs. El agente interno escribe acá: el token necesita scope de escritura.
GSHEET_DJS_ID=

# ── Keys internas (header compartido entre n8n y el backend) ──────────────────
MEMORIA_INTERNAL_KEY=
CSM_INTERNAL_KEY=
MEMORIA_TOPK=5
MEMORIA_MIN_SIMILARITY=0.30

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://sonner.optimizar-ia.com,http://localhost:5173
