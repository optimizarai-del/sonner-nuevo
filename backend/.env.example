# ── Google OAuth2 (mismo del proyecto anterior) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Google Drive resource IDs ─────────────────────────────────────────────────
GOOGLE_DRIVE_TEMPLATE_DOC_ID=16TLMxsuWMaq71Hu3rl41dSxucm53zOXwhBkatFlhTHQ
GOOGLE_DRIVE_CONTRATOS_FOLDER_ID=1CuOv1EDBskL5T3-kzT_cBYE6F9Gz4qnw

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://wndfjicwzmsuxxcsnccl.supabase.co
SUPABASE_ANON_KEY=
# service_role key — saltea RLS. Necesaria para Análisis de CSM (tabla csm_analisis).
SUPABASE_SERVICE_ROLE_KEY=

# ── Análisis de CSM ──────────────────────────────────────────────────────────────
# Key compartida para que n8n registre interacciones vía POST /api/csm/log (header X-CSM-Key).
# Si queda vacía, el endpoint /log no exige key.
CSM_INTERNAL_KEY=

# ── Sub-agente Memoria (vector store) ────────────────────────────────────────────
# LLM del agente: Claude primario (reusa ANTHROPIC_API_KEY / ANTHROPIC_MODEL de arriba),
# OpenAI de reserva, y si ambos fallan cae a un parser determinístico (sin LLM).
# Embeddings OpenAI — DEBE ser el mismo modelo con que se cargó `documents` (1536 dims).
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Key compartida para que n8n consulte vía POST /api/memoria (header X-Memoria-Key).
# Si queda vacía, el endpoint no exige key.
MEMORIA_INTERNAL_KEY=
# Tuning opcional de la búsqueda
MEMORIA_TOPK=5
MEMORIA_MIN_SIMILARITY=0.30

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://sonner.optimizar-ia.com,http://localhost:5180
