# ── Env del Agente Externo (Tomi) — app standalone ──────────────────────────
# Copiá este archivo a .env y completá los valores. En EasyPanel se cargan como
# variables de entorno de la app. Reusá los MISMOS valores que ya usás en el
# backend principal y en n8n (no hace falta rotar nada).

# ── Supabase (mismo proyecto de la plataforma) ──────────────────────────────
SUPABASE_URL=https://wndfjicwzmsuxxcsnccl.supabase.co
SUPABASE_ANON_KEY=                 # copiar del backend actual
SUPABASE_SERVICE_ROLE_KEY=         # copiar del backend actual (service_role)

# ── LLMs ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # copiar del backend actual
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=                    # copiar del backend actual (embeddings + whisper + visión)

# ── Sub-agente Memoria ──────────────────────────────────────────────────────
MEMORIA_INTERNAL_KEY=              # la misma que usa el nodo Memoria de n8n

# ── Google (Calendar + Sheets) — reusa el OAuth de contratos ────────────────
GOOGLE_CLIENT_ID=                  # copiar del backend actual
GOOGLE_CLIENT_SECRET=              # copiar del backend actual
GOOGLE_REFRESH_TOKEN=              # copiar del backend actual
# IDs (ya vienen con default correcto; sólo override si cambian)
# GCAL_EVENTOS_ID=...
# GSHEET_SALONES_ID=...

# ── WhatsApp (YCloud) ───────────────────────────────────────────────────────
YCLOUD_API_KEY=                    # la X-API-Key de YCloud (la del nodo HTTP de n8n)
# YCLOUD_WEBHOOK_SECRET=           # opcional: para verificar la firma ycloud-signature

# ── Aviso de leads a Gabi (Telegram) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                # token del bot que avisa a Gabi
GABI_TELEGRAM_CHAT_ID=6124095544

# ── Buffer de mensajes (segundos) ───────────────────────────────────────────
WA_BUFFER_SECONDS=15
