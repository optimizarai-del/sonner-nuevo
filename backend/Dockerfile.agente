# Dockerfile de la app STANDALONE del Agente Externo (Tomi).
# Mismo código que el backend, pero entrypoint = app.agente_main y UN solo worker
# (el buffer/debounce es en memoria; ver app/agente_main.py).
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 8000

# 1 worker a propósito (buffer en memoria). No agregar --reload en producción.
CMD ["uvicorn", "app.agente_main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
