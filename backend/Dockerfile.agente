# Dockerfile de la app STANDALONE del Agente Externo (Tomi).
# Mismo código que el backend, pero entrypoint = app.agente_main.
#
# Workers: con REDIS_URL configurada el debounce y el dedupe son distribuidos y se puede
# subir WEB_CONCURRENCY. Sin Redis hay que dejarlo en 1 (cada proceso tendría su propio
# buffer y las respuestas agrupadas se romperían). El log de arranque dice en cuál está.
FROM python:3.12-slim

WORKDIR /app

# Logs en tiempo real (sin esto, Docker/EasyPanel no captura la salida de Python).
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 8000

ENV WEB_CONCURRENCY=1

# No agregar --reload en producción.
CMD ["sh", "-c", "uvicorn app.agente_main:app --host 0.0.0.0 --port 8000 --workers ${WEB_CONCURRENCY}"]
